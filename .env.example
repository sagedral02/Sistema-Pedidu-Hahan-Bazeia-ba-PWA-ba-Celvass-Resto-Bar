DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=django-insecure-development-key-change-in-production-123456789
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database
# For SQLite (local default if no postgres running):
DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL:
# DATABASE_URL=postgres://celvas_user:celvas_password@localhost:5432/celvas_db

# Redis / Channels
# REDIS_URL=redis://localhost:6379/0

# Operational
DEFAULT_CURRENCY=USD
TIME_ZONE=Asia/Dili
RESTAURANT_NAME=Restaurante Sabor Dili

# Customer flow
# Where guests land after the thank-you page (e.g. https://celvass-pwa.vercel.app/)
CUSTOMER_HOME_URL=/

# Web Push (leave empty to switch push off). Generate: python manage.py generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@celvass.tl
# 1 = send pushes from a background thread (default), 0 = inline
PUSH_ASYNC=1
